;;; Commentary:

;; Bitmap glyphs for the ANSI raster view.
;;
;; The 8x16 glyphs are the kbd project's default8x16 console font, in
;; CP437 order.  The 8x8 glyphs are the first 256 characters of kbd's
;; drdos8x8 font, also in CP437 order.  Both come from kbd 2.10.0
;; (GPL-2.0-or-later) and are included here under that license's
;; "or later" term.
;;
;; Each glyph is HEIGHT bytes.  Bit 7 of a byte is the leftmost pixel.

;;; Code:

(require 'cl-lib)

(cl-defstruct (ans-vga (:constructor ans-vga--make) (:copier nil))
  "An 8-pixel-wide CP437 bitmap font."
  height
  glyphs)

