(defconst ans-vga--8x16
  (let ((raw (base64-decode-string ans-vga--8x16-b64)))
    (unless (= (length raw) (* 256 16))
      (error "Bad 8x16 VGA font"))
    (ans-vga--make :height 16 :glyphs raw))
  "IBM VGA 8x16 font used for 80x25 ANSI.")

(defconst ans-vga--8x8
  (let ((raw (base64-decode-string ans-vga--8x8-b64)))
    (unless (= (length raw) (* 256 8))
      (error "Bad 8x8 VGA font"))
    (ans-vga--make :height 8 :glyphs raw))
  "8x8 font used when SAUCE names a VGA50 / 80x50 font.")

(defun ans-vga-font (height)
  "Return the built-in VGA font whose glyph height is HEIGHT.
HEIGHT is 8 or 16."
  (cond
   ((= height 8) ans-vga--8x8)
   ((= height 16) ans-vga--8x16)
   (t (error "No VGA font of height %s" height))))

(defun ans-vga-byte (font char row)
  "Return the bitmap byte for CHAR at ROW in FONT.
Bit 7 is the leftmost pixel."
  (aref (ans-vga-glyphs font)
        (+ (* char (ans-vga-height font)) row)))

(provide 'ans-vga)
